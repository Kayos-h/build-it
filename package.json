{
  "name": "buildit-3d-pc-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "tsx server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test scripts/*.test.ts",
    "start": "tsx server/index.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:ui": "node --import tsx scripts/cloud-browser.ts",
    "test:cloud": "node --import tsx scripts/cloud-integration.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/three": "^0.180.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.4"
  }
}
